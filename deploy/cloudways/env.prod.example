# Configuration de PRODUCTION du backend — à copier sur le serveur en backend/.env.local
# (jamais dans Git). Chaque valeur « À_REMPLIR » doit être remplacée.
# Générer un secret : php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"

APP_ENV=prod
APP_DEBUG=0
APP_SECRET=À_REMPLIR_64_caractères_aléatoires
DEFAULT_URI=https://api.academie-esic.fr

# Cloudways : Nginx → (Varnish) → Apache sur la même machine
TRUSTED_PROXIES=127.0.0.1

# Identifiants de la base : Cloudways → Application → Access Details → MySQL
# serverVersion : « mysql --version » en SSH (ex. 8.0.36 pour MySQL, 10.11.8-MariaDB pour MariaDB)
DATABASE_URL="mysql://À_REMPLIR_UTILISATEUR:À_REMPLIR_MOT_DE_PASSE@127.0.0.1:3306/À_REMPLIR_BASE?serverVersion=8.0.36&charset=utf8mb4"

# Clés JWT générées sur le serveur par le script de déploiement (lexik:jwt:generate-keypair)
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=À_REMPLIR_secret_aléatoire
JWT_TOKEN_TTL=3600
# Frontend (academie-esic.fr) et API (api.academie-esic.fr) = même site → lax suffit
JWT_COOKIE_SECURE=1
JWT_COOKIE_SAMESITE=lax

# Origines autorisées (CORS) et contrôle anti-CSRF
CORS_ALLOW_ORIGIN='^https://(www\.)?academie-esic\.fr$'
FRONTEND_URL=https://academie-esic.fr
BACKEND_URL=https://api.academie-esic.fr

VIDEO_TOKEN_SECRET=À_REMPLIR_32_caractères_minimum

# Stripe : clés LIVE (tableau de bord Stripe → Développeurs)
# Webhook : https://api.academie-esic.fr/api/stripe/webhook
#   événements : checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.expired
STRIPE_PUBLIC_KEY=pk_live_À_REMPLIR
STRIPE_SECRET_KEY=sk_live_À_REMPLIR
STRIPE_WEBHOOK_SECRET=whsec_À_REMPLIR

# SMTP transactionnel (Brevo, Mailjet, Elastic Email…) — domaine authentifié SPF + DKIM
# Les caractères spéciaux du mot de passe doivent être encodés (urlencode)
MAILER_DSN=smtp://À_REMPLIR_UTILISATEUR:À_REMPLIR_MOT_DE_PASSE@smtp-relay.brevo.com:587
MAILER_FROM=noreply@academie-esic.fr

MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
LOCK_DSN=flock
