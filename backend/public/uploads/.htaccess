# Fichiers téléversés depuis le back-office : jamais exécutés comme scripts
<FilesMatch "\.(php[0-9]?|phtml|phar|pl|py|cgi|sh)$">
    Require all denied
</FilesMatch>
Options -Indexes -ExecCGI

# Noms de fichiers uniques (régénérés à chaque téléversement) : mise en cache longue durée
# par les navigateurs et le cache de Cloudways
<IfModule mod_headers.c>
    <FilesMatch "\.(webp|jpe?g|png|gif|avif)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
