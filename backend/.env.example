# Modèle de configuration — copier en .env.local (dev) ou définir en variables d'environnement (prod).
# Ne JAMAIS committer de vraies valeurs.

###> symfony/framework-bundle ###
# Production : APP_ENV=prod et APP_DEBUG=0 (sinon les erreurs renvoient la trace complète et les chemins du serveur)
APP_ENV=dev
APP_DEBUG=1
# Chaîne aléatoire de 64 caractères : php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=change-me
# URL de base utilisée pour générer des liens hors requête HTTP (commandes, emails)
DEFAULT_URI=http://localhost:8000
# Reverse proxys dont les en-têtes X-Forwarded-* sont acceptés (Cloudways : 127.0.0.1)
TRUSTED_PROXIES=127.0.0.1
###< symfony/framework-bundle ###

###> symfony/debug-bundle ###
VAR_DUMPER_SERVER=127.0.0.1:9912
###< symfony/debug-bundle ###

###> doctrine/doctrine-bundle ###
# serverVersion = version réelle du serveur (MySQL : 8.0.46 ; MariaDB : ex. 10.11.8-MariaDB)
DATABASE_URL="mysql://user:password@db:3306/academie_esic?serverVersion=8.0.46&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change-me
# Durée de vie du token et du cookie httpOnly (secondes)
JWT_TOKEN_TTL=3600
# 1 en production (https). 0 uniquement en dev http://localhost
JWT_COOKIE_SECURE=1
# lax si frontend et API partagent le même site ; none si domaines différents (exige JWT_COOKIE_SECURE=1)
JWT_COOKIE_SAMESITE=lax
###< lexik/jwt-authentication-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

# URL publique exacte du frontend (CORS avec cookies, contrôle anti-CSRF de l'en-tête Origin, liens des emails)
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Secret des liens vidéo signés (32 caractères minimum)
VIDEO_TOKEN_SECRET=change-me-with-at-least-32-characters

###> stripe ###
STRIPE_PUBLIC_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
###< stripe ###

# Dev : MailHog. Prod : SMTP réel, ex. smtp://UTILISATEUR:MOT_DE_PASSE@smtp-relay.brevo.com:587
MAILER_DSN=smtp://mailhog:1025
# Expéditeur des emails (adresse d'un domaine authentifié SPF/DKIM chez le fournisseur SMTP)
MAILER_FROM=noreply@academie-esic.fr
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
LOCK_DSN=flock

# Fixtures (dev uniquement) : mot de passe du compte admin@esic.fr, 12 caractères minimum
FIXTURES_ADMIN_PASSWORD=
