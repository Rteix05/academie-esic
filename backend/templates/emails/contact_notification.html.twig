{% extends 'emails/layout.html.twig' %}
{% import 'emails/_components.html.twig' as ui %}

{% block content %}
    <p style="margin:24px 4px 0 4px;font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#1C2C24;">
        Un nouveau message a été envoyé depuis le formulaire de contact du site.
        Répondez directement à cet email : la réponse partira vers l'adresse du visiteur.
    </p>

    {{ ui.card('Expéditeur', [
        { label: 'Nom', value: name },
        { label: 'Email', value: visitor_email },
        { label: 'Sujet', value: subject_label },
        { label: 'Reçu le', value: sent_at|date('d/m/Y à H:i') },
    ]) }}

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:16px;background-color:#F6F7F5;border-radius:16px;">
        <tr>
            <td style="padding:20px 24px;font-family:Arial,Helvetica,sans-serif;">
                <div style="font-size:15px;font-weight:bold;color:#0F291E;">Message</div>
                {{ ui.quote(message) }}
            </td>
        </tr>
    </table>
{% endblock %}

{% block footer_note %}
    Notification interne envoyée automatiquement par le site academie-esic.fr.
{% endblock %}
