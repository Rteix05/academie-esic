{% extends 'emails/layout.html.twig' %}
{% import 'emails/_components.html.twig' as ui %}

{% block content %}
    <p style="margin:24px 4px 0 4px;font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#1C2C24;">
        Bonjour <strong>{{ display_name }}</strong>,<br>
        nous vous confirmons votre commande. Votre contenu est maintenant disponible dans votre espace personnel.
    </p>

    {{ ui.card('Votre commande', [
        { label: 'Contenu', value: payment.label },
        { label: 'Date de commande', value: payment.createdAt|date('d/m/Y à H:i') },
        { label: 'Référence', value: reference },
    ], { label: 'Total payé', value: ui.amount(payment.amountCents, payment.currency) }) }}

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:16px;background-color:#F6F7F5;border-radius:16px;">
        <tr>
            <td style="padding:20px 24px;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.6;color:#3F4A44;">
                <div style="font-size:15px;font-weight:bold;color:#0F291E;margin-bottom:8px;">Conditions applicables</div>
                {% if payment.cgvVersion %}
                    Vous avez accepté les Conditions Générales de Vente (version du {{ payment.cgvVersion matches '/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/' ? payment.cgvVersion|date('d/m/Y') : payment.cgvVersion }})
                    le {{ payment.cgvAcceptedAt|date('d/m/Y à H:i') }}. Elles sont consultables à l'adresse :
                {% else %}
                    Les Conditions Générales de Vente sont consultables à l'adresse :
                {% endif %}
                <a href="{{ cgv_url }}" style="color:#047857;">{{ cgv_url }}</a>

                {% if payment.immediateAccessConsentAt %}
                    <div style="margin-top:12px;">Le {{ payment.immediateAccessConsentAt|date('d/m/Y à H:i') }}, avant le paiement, vous avez coché la mention suivante :</div>
                    {{ ui.quote('« ' ~ consent_statement ~ ' »') }}
                {% endif %}
            </td>
        </tr>
    </table>
{% endblock %}

{% block footer_note %}
    Cet email confirme votre commande et les conditions acceptées : conservez-le pour vos archives.
    Merci de ne pas y répondre ; pour toute question, écrivez à {{ contact_email }}.
{% endblock %}
