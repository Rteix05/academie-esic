{% extends 'emails/layout.html.twig' %}
{% import 'emails/_components.html.twig' as ui %}

{% block content %}
    <p style="margin:24px 4px 0 4px;font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#1C2C24;">
        Bonjour <strong>{{ display_name }}</strong>,<br>
        {% if paid %}
            votre inscription payante à cet événement est confirmée.
        {% else %}
            votre inscription à cet événement a bien été enregistrée.
        {% endif %}
    </p>

    {{ ui.card('Votre événement', [
        { label: 'Événement', value: event.title },
        { label: 'Date', value: event.startDate|date('d/m/Y à H:i') },
        { label: 'Lieu', value: event.location },
    ]) }}
{% endblock %}
