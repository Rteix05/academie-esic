{#
    Gabarit commun des emails transactionnels (expéditeur noreply).

    Structure en tableaux et styles en ligne : seule approche fiable dans Gmail, Outlook et Apple Mail.
    Variables :
      preheader    — aperçu affiché dans la boîte de réception
      badge        — étiquette à côté du logo (ex. « Commande »)
      hero_icon    — icône Lucide de la pastille (nom de fichier dans emails/icons/, défaut « check » ;
                     icônes générées par frontend/scripts/generate-email-icons.mjs)
      hero_title   — titre du bandeau vert
      hero_text    — phrase sous le titre
      hero_meta    — liste de { label, value } affichée dans le bandeau
      cta_url / cta_label — bouton principal (optionnel)
      reply_note   — true : le destinataire peut écrire à l'adresse de contact (pas de réponse au noreply)
    Blocs : content (encarts sous le bandeau)
#}
{%- set frontend = frontend_url|default('') -%}
<!DOCTYPE html>
<html lang="fr" xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
    <meta name="supported-color-schemes" content="light">
    <title>{{ hero_title|default('Académie E.S.I.C.') }}</title>
</head>
<body style="margin:0;padding:0;background-color:#F3F4F1;-webkit-text-size-adjust:100%;">
    {# Aperçu dans la boîte de réception (masqué dans le corps) #}
    <div style="display:none;max-height:0;overflow:hidden;opacity:0;color:#F3F4F1;font-size:1px;line-height:1px;">
        {{ preheader|default(hero_text|default('')) }}&#8203;&nbsp;&#8203;&nbsp;&#8203;&nbsp;&#8203;&nbsp;
    </div>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#F3F4F1;">
        <tr>
            <td align="center" style="padding:32px 12px;">
                <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:600px;background-color:#FFFFFF;border-radius:24px;box-shadow:0 10px 30px rgba(15,41,30,0.08);">
                    <tr>
                        <td style="padding:28px 32px 8px 32px;font-family:Arial,Helvetica,sans-serif;">

                            {# ── En-tête : logo + étiquette ── #}
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td style="vertical-align:middle;">
                                        <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                                            <tr>
                                                {# Logo : icône Lucide BookOpen, comme sur le site #}
                                                <td style="width:38px;height:38px;background-color:#0F291E;border-radius:11px;text-align:center;vertical-align:middle;">
                                                    <img src="{{ email.image('emails/icons/book-open.png') }}" width="20" height="20" alt="" style="display:block;margin:0 auto;border:0;width:20px;height:20px;">
                                                </td>
                                                <td style="padding-left:10px;vertical-align:middle;font-family:Arial,Helvetica,sans-serif;">
                                                    <div style="font-size:16px;font-weight:bold;color:#0F291E;letter-spacing:0.2px;">Académie E.S.I.C.</div>
                                                    <div style="font-size:11px;color:#5B6660;">Formation chrétienne</div>
                                                </td>
                                                {% if badge is defined and badge %}
                                                    <td style="padding-left:12px;vertical-align:middle;">
                                                        <span style="display:inline-block;padding:4px 12px;background-color:#FEF3C7;border:1px solid #FCD34D;border-radius:999px;font-size:11px;font-weight:bold;color:#92400E;">{{ badge }}</span>
                                                    </td>
                                                {% endif %}
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>

                            {# ── Bandeau principal ── #}
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:24px;background-color:#E7F6EC;border-radius:20px;">
                                <tr>
                                    <td align="center" style="padding:32px 28px;font-family:Arial,Helvetica,sans-serif;">
                                        <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                                            <tr>
                                                <td style="width:56px;height:56px;background-color:#CFEFD9;border-radius:28px;text-align:center;vertical-align:middle;">
                                                    <table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center">
                                                        <tr>
                                                            {# Icône Lucide (PNG blanc intégré à l'email) #}
                                                            <td style="width:36px;height:36px;background-color:#047857;border-radius:18px;text-align:center;vertical-align:middle;">
                                                                <img src="{{ email.image('emails/icons/' ~ hero_icon|default('check') ~ '.png') }}" width="20" height="20" alt="" style="display:block;margin:0 auto;border:0;width:20px;height:20px;">
                                                            </td>
                                                        </tr>
                                                    </table>
                                                </td>
                                            </tr>
                                        </table>
                                        <h1 style="margin:18px 0 0 0;font-size:26px;line-height:1.25;font-weight:bold;color:#047857;">{{ hero_title|default('') }}</h1>
                                        {% if hero_text is defined and hero_text %}
                                            <p style="margin:10px 0 0 0;font-size:15px;line-height:1.5;color:#3F4A44;">{{ hero_text }}</p>
                                        {% endif %}
                                        {% if hero_meta is defined and hero_meta %}
                                            <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin-top:20px;">
                                                <tr>
                                                    {% for item in hero_meta %}
                                                        <td style="font-family:Arial,Helvetica,sans-serif;padding:0 14px;text-align:left;vertical-align:top;">
                                                            <div style="font-family:Arial,Helvetica,sans-serif;font-size:10px;font-weight:bold;letter-spacing:0.8px;text-transform:uppercase;color:#5B6660;">{{ item.label }}</div>
                                                            <div style="font-family:Arial,Helvetica,sans-serif;margin-top:3px;font-size:14px;color:#0F291E;">{{ item.value }}</div>
                                                        </td>
                                                    {% endfor %}
                                                </tr>
                                            </table>
                                        {% endif %}
                                    </td>
                                </tr>
                            </table>

                            {# ── Contenu propre à chaque email ── #}
                            {% block content %}{% endblock %}

                            {# ── Bouton principal ── #}
                            {% if cta_url is defined and cta_url %}
                                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:24px;">
                                    <tr>
                                        <td align="center">
                                            <a href="{{ cta_url }}" style="display:inline-block;padding:14px 28px;background-color:#0F291E;border-radius:999px;font-family:Arial,Helvetica,sans-serif;font-size:15px;font-weight:bold;color:#FFFFFF;text-decoration:none;">{{ cta_label|default('Accéder au site') }}&nbsp;&nbsp;<img src="{{ email.image('emails/icons/arrow-right.png') }}" width="16" height="16" alt="" style="display:inline-block;vertical-align:-3px;border:0;width:16px;height:16px;"></a>
                                        </td>
                                    </tr>
                                </table>
                            {% endif %}

                            {# ── Pied de page ── #}
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:32px;border-top:1px solid #E5E7E3;">
                                <tr>
                                    <td align="center" style="padding:24px 8px 16px 8px;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:1.6;color:#5B6660;">
                                        <div style="font-weight:bold;color:#0F291E;">Académie E.S.I.C.</div>
                                        <div>Contact : <a href="mailto:{{ contact_email }}" style="color:#047857;">{{ contact_email }}</a></div>
                                        {% if frontend %}
                                            <div style="margin-top:6px;">
                                                <a href="{{ frontend }}" style="color:#5B6660;">academie-esic.fr</a> &middot;
                                                <a href="{{ frontend }}/cgv" style="color:#5B6660;">CGV</a> &middot;
                                                <a href="{{ frontend }}/politique-de-confidentialite" style="color:#5B6660;">Confidentialité</a>
                                            </div>
                                        {% endif %}
                                        <div style="margin-top:10px;color:#6B7280;">
                                            {% block footer_note %}
                                                Cet email vous est envoyé automatiquement : merci de ne pas y répondre.
                                                Pour toute question, écrivez à {{ contact_email }}.
                                            {% endblock %}
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
